{
  "name": "kova-store-training",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node server/index.mjs",
    "dev:web": "vite --config web/vite.config.mjs",
    "build": "vite build --config web/vite.config.mjs",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit --project web/tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
